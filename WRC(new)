        <div style={{ padding:40, maxWidth:800, margin:"0 auto", width:"100%", overflowY:"auto" }}>
          <h2 style={{ fontSize:28, marginBottom:24, fontWeight:900 }}>🏆 Rankings</h2>
          {ranked.map((t, i) => (
            <div key={t.id} style={{ display:"flex", alignItems:"center", background:C.white, padding:"20px 24px", marginBottom:12, border:`1px solid ${C.border}` }}>
              <div style={{ fontSize:24, fontWeight:900, width:60 }}>#{i+1}</div>
              <div style={{ flex:1 }}><div style={{ fontWeight:700, fontSize:18 }}>{t.name}</div></div>
              <div style={{ textAlign:"right", fontWeight:900, fontSize:18 }}>{t.score.toLocaleString()} pts</div>
            </div>
          ))}
        </div>
      );
    }

    function DashboardPage({ user, technicians, onLogin, onPayment }) {
      const [adSlots, setAdSlots] = useState([]);
      const [showAdForm, setShowAdForm] = useState(false);
      const [adFile, setAdFile] = useState(null);
      const [adFilePreview, setAdFilePreview] = useState(null);
      const [adStart, setAdStart] = useState("");
      const [adEnd, setAdEnd] = useState("");
      const [adBooking, setAdBooking] = useState(false);
      const [adMsg, setAdMsg] = useState("");

      useEffect(()=>{ API.getAdSlots().then(s=>setAdSlots(s)); },[]);

      const handleAdFile = (e) => {
        const f = e.target.files[0]; if(!f) return;
        const r = new FileReader();
        r.onload = (ev) => { setAdFile(ev.target.result); setAdFilePreview(ev.target.result); };
        r.readAsDataURL(f);
      };

      const isDateRangeConflict = (start, end) => {
        const s = new Date(start).getTime(), e = new Date(end).getTime();
        return adSlots.some(slot => {
          const ss = new Date(slot.startDate).getTime(), se = new Date(slot.endDate).getTime();
          return !(e < ss || s > se);
        });
      };

      const handleBookAd = async () => {
        if (!adFile) { setAdMsg("Please upload an ad file."); return; }
        if (!adStart || !adEnd) { setAdMsg("Please select start and end dates."); return; }
        if (new Date(adEnd) <= new Date(adStart)) { setAdMsg("End date must be after start date."); return; }
        if (isDateRangeConflict(adStart, adEnd)) { setAdMsg("This date range is already booked. Please choose different dates."); return; }
        const days = Math.ceil((new Date(adEnd)-new Date(adStart))/(1000*60*60*24));
        const total = days * 49;
        if (!window.confirm(`Book ad from ${adStart} to ${adEnd}?\n${days} day(s) × $49 = $${total}\n\nProceed to payment?`)) return;
        setAdBooking(true);
        await new Promise(r=>setTimeout(r,1200));
        await API.bookAdSlot({ startDate:adStart, endDate:adEnd, file:adFile, bookedBy: user.name, total });
        const slots = await API.getAdSlots();
        setAdSlots(slots);
        setAdBooking(false);
        setShowAdForm(false);
        setAdFile(null); setAdFilePreview(null); setAdStart(""); setAdEnd(""); setAdMsg("");
      };

      const today = new Date().toISOString().split("T")[0];

      if (!user) return <div style={{ padding:60, textAlign:"center", width:"100%" }}><button onClick={onLogin} style={accentBtn}>Login to access</button></div>;
      const myTech = technicians.find(t => t.id === user.techId);

      return (
        <div style={{ padding:40, maxWidth:720, margin:"0 auto", width:"100%", overflowY:"auto", height:"100%" }}>
          <h2 style={{ fontSize:28, marginBottom:24, fontWeight:900 }}>Dashboard</h2>

          {/* My Info */}
          <div style={{ background:C.white, padding:28, border:`1px solid ${C.border}`, marginBottom:20 }}>
            <h3 style={{ margin:"0 0 16px 0", fontSize:15, fontWeight:800 }}>My Information</h3>
            <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:"8px 20px", fontSize:14 }}>
              <div><strong>Name:</strong> {user.name}</div>
              <div><strong>Nickname:</strong> {user.nickname || "—"}</div>
              <div><strong>Email:</strong> {user.email}</div>
              <div><strong>Language:</strong> {LANGUAGES.find(l=>l.code===(user.language||"en"))?.label || "English"}</div>
              <div><strong>Account:</strong> {user.userType}</div>
              {user.userType === "technician" && <div><strong>Flags Owned:</strong> {user.flagsOwned || 0} | Deployed: {user.flagsDeployed || 0}</div>}
            </div>
            {user.userType === "technician" && (
              <div style={{ marginTop:16, paddingTop:16, borderTop:`1px solid ${C.border}` }}>
                {myTech?.active
                  ? <div style={{ color:C.green, fontWeight:700 }}>✓ Flag Active on Map</div>
                  : <button onClick={onPayment} style={{ ...accentBtn, padding:"12px 24px" }}>💳 Buy Flag ($19/mo)</button>
                }
              </div>
            )}
          </div>

          {/* ── AD BOARD ── */}
          <div style={{ background:C.white, border:`1px solid ${C.border}`, marginBottom:20 }}>
            <div style={{ padding:"18px 24px", borderBottom:`1px solid ${C.border}`, display:"flex", justifyContent:"space-between", alignItems:"center" }}>
              <div>
                <h3 style={{ margin:0, fontSize:15, fontWeight:800 }}>📢 Advertisement Board</h3>
                <div style={{ fontSize:12, color:C.textMuted, marginTop:2 }}>Promote your business — $49 / day</div>
              </div>
              <button onClick={()=>{ setShowAdForm(!showAdForm); setAdMsg(""); }} style={{ ...accentBtn, padding:"8px 18px", fontSize:12 }}>
                {showAdForm ? "Cancel" : "+ Book Ad Slot"}
              </button>
            </div>

            {/* Book form */}
            {showAdForm && (
              <div style={{ padding:"20px 24px", borderBottom:`1px solid ${C.border}`, background:C.surface }}>
                <div style={{ display:"grid", gap:12 }}>
                  <div>
                    <label style={{ display:"block", fontWeight:700, fontSize:12, marginBottom:5 }}>Upload Ad File (image/video)</label>
                    <input type="file" accept="image/*,video/*" onChange={handleAdFile} style={{ fontSize:13 }} />
                    {adFilePreview && adFilePreview.startsWith("data:image") && (
                      <img src={adFilePreview} style={{ marginTop:8, maxHeight:100, border:`1px solid ${C.border}` }} />
                    )}
                  </div>
                  <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:12 }}>
                    <div>
                      <label style={{ display:"block", fontWeight:700, fontSize:12, marginBottom:5 }}>Start Date</label>
                      <input type="date" min={today} value={adStart} onChange={e=>setAdStart(e.target.value)} style={{ ...inputStyle, padding:"10px 12px" }} />
                    </div>
                    <div>
                      <label style={{ display:"block", fontWeight:700, fontSize:12, marginBottom:5 }}>End Date</label>
                      <input type="date" min={adStart||today} value={adEnd} onChange={e=>setAdEnd(e.target.value)} style={{ ...inputStyle, padding:"10px 12px" }} />
                    </div>
                  </div>
                  {adStart && adEnd && new Date(adEnd) > new Date(adStart) && (
                    <div style={{ background:"#f0f8ff", border:"1px solid #b3d9ff", padding:"10px 14px", fontSize:13 }}>
                      {Math.ceil((new Date(adEnd)-new Date(adStart))/(1000*60*60*24))} day(s) ×
                      $49 = <strong>${Math.ceil((new Date(adEnd)-new Date(adStart))/(1000*60*60*24))*49}</strong>
                    </div>
                  )}
                  {adMsg && <div style={{ color:C.red, fontSize:12, fontWeight:600 }}>{adMsg}</div>}
                  <button onClick={handleBookAd} disabled={adBooking} style={{ ...accentBtn, padding:"12px", fontSize:14 }}>
                    {adBooking ? "Processing payment..." : "Confirm & Pay"}
                  </button>
                </div>
              </div>
            )}

            {/* Booked slots calendar view */}
            <div style={{ padding:"18px 24px" }}>
              <div style={{ fontWeight:700, fontSize:13, marginBottom:12 }}>Booked Slots</div>
              {adSlots.length === 0 ? (
                <div style={{ color:C.textMuted, fontSize:13, textAlign:"center", padding:"20px 0" }}>No ads booked yet. Be the first!</div>
              ) : (
                <div style={{ display:"grid", gap:10 }}>
                  {adSlots.map(slot => (
                    <div key={slot.id} style={{ display:"flex", gap:14, alignItems:"center", padding:"12px 14px", border:`1px solid ${C.border}`, background:C.surface }}>
                      {slot.file && slot.file.startsWith("data:image") && (
                        <img src={slot.file} style={{ width:56, height:40, objectFit:"cover", border:`1px solid ${C.border}`, flexShrink:0 }} />
                      )}
                      <div style={{ flex:1 }}>
                        <div style={{ fontWeight:700, fontSize:13 }}>{slot.bookedBy}</div>
                        <div style={{ fontSize:12, color:C.textMuted }}>{slot.startDate} → {slot.endDate}</div>
                      </div>
                      <div style={{ fontWeight:700, fontSize:13, color:C.green }}>${slot.total}</div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      );
    }

    /* ══════════════ AUTH MODAL (all features integrated) ══════════════ */
    function AuthModal({ mode, onAuth, onClose, onSwitch, notify, onShowPrivacy }) {
      const isLogin = mode === "login";
      const [signupType, setSignupType] = useState("consumer");
      
      const [form, setForm] = useState({ email:"", password:"", name:"", phone:"", specialty: Object.keys(TECH_CATEGORIES)[0] });
      const [confirmPassword, setConfirmPassword] = useState("");
      const [errors, setErrors] = useState({});
      
      // Email verification
      const [isEmailVerified, setIsEmailVerified] = useState(false);
      const [generatedCode, setGeneratedCode] = useState("");
      const [inputCode, setInputCode] = useState("");
      
      // Name check
      const [isNameVerified, setIsNameVerified] = useState(false);
      
      // Phone
      const [phonePrefix, setPhonePrefix] = useState("-"); // default: -

      const [privacyChecked, setPrivacyChecked] = useState(false);
      const [licenseAttached, setLicenseAttached] = useState(false);

      const passwordsMatch = form.password && form.password === confirmPassword;

      const setError = (field, msg) => setErrors(prev => ({ ...prev, [field]: msg }));
      const clearError = (field) => setErrors(prev => { const n={...prev}; delete n[field]; return n; });

      const handleCheckName = () => {
        if (!form.name.trim()) return setError("name", "Please enter a name first.");
        const users = DB.get("users");
        const techs = DB.get("technicians");
        const exists = users.some(u => u.name.toLowerCase() === form.name.trim().toLowerCase()) || 
                       techs.some(t => t.name.toLowerCase() === form.name.trim().toLowerCase());
        if (exists) {
          setError("name", "This name is already taken.");
          setIsNameVerified(false);
        } else {
          clearError("name");
          setIsNameVerified(true);
        }
      };

      const handleNameChange = (e) => { setForm({...form, name:e.target.value}); setIsNameVerified(false); clearError("name"); };

      const handleSendCode = () => {
        if(!form.email) { setError("email","Please enter email first."); return; }
        clearError("email");
        const code = Math.floor(100000 + Math.random() * 900000).toString();
        setGeneratedCode(code);
        alert(`[Email Simulation] Verification code sent to: ${form.email}\n\nCode: ${code}\n\n(In production this would arrive by email)`);
      };

      const handleVerify = () => {
        if(inputCode === generatedCode && generatedCode !== "") {
          setIsEmailVerified(true); clearError("verifyCode"); notify("Email Verified ✓");
        } else {
          setError("verifyCode", "Incorrect code. Please try again.");
        }
      };

      const handleSubmit = () => {
        const newErrors = {};
        if (isLogin) {
          if(!form.email) newErrors.email = "Email is required.";
          if(!form.password) newErrors.password = "Password is required.";
          if (Object.keys(newErrors).length) { setErrors(newErrors); return; }
          return onAuth({ email:form.email, password:form.password, userType:"login" });
        }
        
        if(!form.name) newErrors.name = "Name is required.";
        else if(!isNameVerified) newErrors.name = "Please check name availability.";
        if(!form.email) newErrors.email = "Email is required.";
        if(!isEmailVerified) newErrors.email = (newErrors.email || "") || "Email must be verified.";
        if(!form.password) newErrors.password = "Password is required.";
        if(!passwordsMatch) newErrors.confirmPassword = "Passwords do not match.";
        if(!privacyChecked) newErrors.privacy = "You must accept the Privacy Policy.";
        
        if (signupType === "technician") {
          if (phonePrefix === "-") newErrors.phone = "Please select a country code.";
          else if (!form.phone) newErrors.phone = "Phone number is required.";
          if(!licenseAttached) newErrors.license = "Certificate/License upload is required.";

          if (!newErrors.phone && phonePrefix !== "-") {
            const finalPhone = `${phonePrefix} ${form.phone}`;
            const allTechs = DB.get("technicians");
            const phoneExists = allTechs.some(t => t.phone === finalPhone);
            if (phoneExists) { newErrors.phone = "This phone number is already registered."; }
          }
        }
        
        if (Object.keys(newErrors).length) { setErrors(newErrors); return; }

        const finalPhone = phonePrefix !== "-" ? `${phonePrefix} ${form.phone}` : form.phone;
        onAuth({ ...form, phone: finalPhone, userType: signupType });
      };

      const ErrMsg = ({ field }) => errors[field] ? <div style={{ color:C.red, fontSize:12, marginTop:4, fontWeight:600 }}>✗ {errors[field]}</div> : null;

      return (
        <div style={{ position:"fixed", top:0, left:0, right:0, bottom:0, background:"rgba(0,0,0,0.7)", display:"flex", alignItems:"center", justifyContent:"center", zIndex:50000 }}>
          <div style={{ background:C.white, border:`2px solid ${C.text}`, padding:32, width:440, maxHeight:"92vh", overflowY:"auto" }}>
            
            <h2 style={{ marginTop:0, marginBottom:24, fontWeight:900, fontSize:22 }}>{isLogin ? "Log In" : "Create Account"}</h2>

            {!isLogin && (
              <div style={{ display:"flex", border:`1px solid ${C.text}`, marginBottom:24, background:C.surface }}>
                <button onClick={() => setSignupType("consumer")} style={{ flex:1, padding:12, fontWeight:700, border:"none", background: signupType==="consumer"?C.text:"transparent", color: signupType==="consumer"?C.white:C.text, cursor:"pointer" }}>
                  Consumer
                </button>
                <button onClick={() => setSignupType("technician")} style={{ flex:1, padding:12, fontWeight:700, border:"none", background: signupType==="technician"?C.text:"transparent", color: signupType==="technician"?C.white:C.text, cursor:"pointer" }}>
                  Technician (수리기사)
                </button>
              </div>
            )}

            <div style={{ display:"grid", gap:14, marginBottom:20 }}>
              
              {/* Name */}
              {!isLogin && (
                <div>
                  <div style={{ display:"flex", gap:8 }}>
                    <input placeholder="Full Name or Username" style={{...inputStyle, flex:1}} value={form.name} onChange={handleNameChange} />
                    <button onClick={handleCheckName} style={{...ghostBtn, padding:"0 12px", whiteSpace:"nowrap"}}>Check</button>
                  </div>
                  {!isLogin && isNameVerified && <div style={{ color:C.green, fontSize:12, fontWeight:700, marginTop:4 }}>✓ Name is available</div>}
                  <ErrMsg field="name" />
                </div>
              )}
              
              {/* Email + verification code (Feature 2) */}
              <div>
                <div style={{ display:"flex", gap:8 }}>
                  <input placeholder="Email Address" type="email" disabled={isEmailVerified} style={{...inputStyle, flex:1}} value={form.email} onChange={e=>{setForm({...form, email:e.target.value}); clearError("email");}} />
                  {!isLogin && !isEmailVerified && <button onClick={handleSendCode} style={{...ghostBtn, padding:"0 12px", whiteSpace:"nowrap"}}>Send Code</button>}
                </div>
                <ErrMsg field="email" />
                {/* Code input box (always visible after send) */}
                {!isLogin && generatedCode && !isEmailVerified && (
                  <div style={{ background:C.surface, border:`1px solid ${C.border}`, padding:12, marginTop:8 }}>
                    <p style={{ color:C.red, fontSize:11, fontWeight:700, margin:"0 0 8px 0" }}>⚠️ Do not share this code with anyone.</p>
                    <div style={{ display:"flex", gap:8 }}>
                      <input placeholder="Enter the 6-digit code" style={{...inputStyle, flex:1, letterSpacing:"0.12em"}} value={inputCode} onChange={e=>{ setInputCode(e.target.value); clearError("verifyCode"); }} maxLength={6} />
                      <button onClick={handleVerify} style={{...accentBtn, padding:"0 16px"}}>Verify</button>
                    </div>
                    <ErrMsg field="verifyCode" />
                  </div>
                )}
                {!isLogin && isEmailVerified && <div style={{ color:C.green, fontSize:12, fontWeight:700, marginTop:6 }}>✓ Email Verified</div>}
              </div>

              {/* Password */}
              <div>
                <input type="password" placeholder="Password" style={inputStyle} value={form.password} onChange={e=>{setForm({...form, password:e.target.value}); clearError("password");}} />
                <ErrMsg field="password" />
              </div>
              {!isLogin && (
                <div>
                  <input type="password" placeholder="Confirm Password" style={inputStyle} value={confirmPassword} onChange={e=>{setConfirmPassword(e.target.value); clearError("confirmPassword");}} />
                  {confirmPassword && (
                    <div style={{ fontSize:12, fontWeight:700, marginTop:4, color: passwordsMatch ? C.green : C.red }}>
                      {passwordsMatch ? "✓ Passwords match" : "✗ Passwords do not match"}
                    </div>
                  )}
                  <ErrMsg field="confirmPassword" />
                </div>
              )}

              {/* Technician fields */}
              {!isLogin && signupType === "technician" && (
                <>
                  {/* Phone with all countries (Feature 3) */}
                  <div>
                    <div style={{ display:"flex", gap:8 }}>
                      <select 
                        style={{ ...inputStyle, width:"180px", padding:"0 8px", cursor:"pointer", flexShrink:0 }} 
                        value={phonePrefix} 
                        onChange={(e) => { setPhonePrefix(e.target.value); clearError("phone"); }}
                      >
                        {ALL_COUNTRIES.map(c => (
                          <option key={c.code+c.name} value={c.code}>
                            {c.flag} {c.code === "-" ? c.name : `${c.name} (${c.code})`}
                          </option>
                        ))}
                      </select>
                      <input 
                        placeholder="Phone Number" 
                        style={{...inputStyle, flex:1}} 
                        value={form.phone} 
                        onChange={e=>{setForm({...form, phone:e.target.value}); clearError("phone");}} 
                        disabled={phonePrefix==="-"}
                      />
                    </div>
                    <ErrMsg field="phone" />
                  </div>

                  <select style={inputStyle} value={form.specialty} onChange={e=>setForm({...form, specialty:e.target.value})}>
                    {Object.keys(TECH_CATEGORIES).map(cat => <option key={cat} value={cat}>{cat}</option>)}
                  </select>

                  <div style={{ background:C.surface, border:`1px solid ${C.border}`, padding:12 }}>
                    <span style={{ display:"block", fontSize:12, fontWeight:700, marginBottom:8 }}>Upload Professional License (Required)</span>
                    <input type="file" accept="image/*,application/pdf" onChange={() => { setLicenseAttached(true); clearError("license"); }} style={{ fontSize:12 }} />
                    {licenseAttached && <div style={{ color:C.green, fontSize:12, fontWeight:700, marginTop:4 }}>✓ License attached</div>}
                    <ErrMsg field="license" />
                    <p style={{ margin:"8px 0 0 0", fontSize:11, color:C.red, fontWeight:600, lineHeight:1.4 }}>
                      ⚠️ Forged certificates will result in account termination and legal action.
                    </p>
                  </div>
                </>
              )}
            </div>

            {/* Privacy (Feature 4) */}
            {!isLogin && (
              <div style={{ marginBottom:20 }}>
                <label style={{ display:"flex", alignItems:"flex-start", gap:8, fontSize:12, color:C.textMid, cursor:"pointer" }}>
                  <input type="checkbox" checked={privacyChecked} onChange={e=>{setPrivacyChecked(e.target.checked); clearError("privacy");}} style={{ marginTop:2 }} />
                  <span>
                    I have read and agree to the{" "}
                    <span onClick={onShowPrivacy} style={{ color:C.blue, textDecoration:"underline", cursor:"pointer", fontWeight:700 }}>Terms of Service and Privacy Policy</span>
                    {" "}(GDPR · CCPA · PIPEDA).
                    <br/><span style={{ fontSize:11, color:C.textMuted }}>개인정보 수집 및 이용에 동의합니다.</span>
                  </span>
                </label>
                <ErrMsg field="privacy" />
              </div>
            )}

            <button onClick={handleSubmit} style={{ ...accentBtn, width:"100%", marginBottom:16, padding:14, fontSize:15 }}>
              {isLogin ? "Log In" : "Complete Registration"}
            </button>
            
            <div style={{ textAlign:"center", fontSize:13, color:C.textMid, marginBottom:16 }}>
              {isLogin ? "Don't have an account?" : "Already have an account?"}{" "}
              <strong style={{ color:C.text, cursor:"pointer", textDecoration:"underline" }} onClick={() => onSwitch(isLogin ? "signup" : "login")}>
                {isLogin ? "Sign Up" : "Log In"}
              </strong>
            </div>
            <button onClick={onClose} style={{ ...ghostBtn, width:"100%", padding:12 }}>Cancel</button>
          </div>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById("root"));
    root.render(<WRCApp />);
  </script>
</body>
</html>
