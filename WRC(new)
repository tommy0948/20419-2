      // Detect script/language of query to request localized results
      const detectLang = (q) => {
        if (!q) return "en";
        const hasKorean = /[\uAC00-\uD7AF\u1100-\u11FF\u3130-\u318F]/.test(q);
        if (hasKorean) return "ko";
        const hasChinese = /[\u4E00-\u9FFF\u3400-\u4DBF]/.test(q);
        if (hasChinese) return "zh";
        const hasJapanese = /[\u3040-\u309F\u30A0-\u30FF]/.test(q);
        if (hasJapanese) return "ja";
        const hasArabic = /[\u0600-\u06FF]/.test(q);
        if (hasArabic) return "ar";
        const hasRussian = /[\u0400-\u04FF]/.test(q);
        if (hasRussian) return "ru";
        const hasThai = /[\u0E00-\u0E7F]/.test(q);
        if (hasThai) return "th";
        const hasHindi = /[\u0900-\u097F]/.test(q);
        if (hasHindi) return "hi";
        const hasGreek = /[\u0370-\u03FF]/.test(q);
        if (hasGreek) return "el";
        const hasHebrew = /[\u0590-\u05FF]/.test(q);
        if (hasHebrew) return "he";
        const hasVietnamese = /[\u1EA0-\u1EF9àáâãèéêìíòóôõùúýăđơưạảấầẩẫậắặẻẽếềệỉịọỏốồổỗộớờởỡợụủứừửữựỳỷỹ]/.test(q);
        if (hasVietnamese) return "vi";
        const hasTurkish = /[ğşıİÇÖÜüöç]/.test(q);
        if (hasTurkish) return "tr";
        const hasGerman = /[äöüÄÖÜß]/.test(q);
        if (hasGerman) return "de";
        const hasSpanish = /[áéíóúüñ¿¡]/.test(q);
        if (hasSpanish) return "es";
        const hasFrench = /[àâæçéèêëîïôœùûüÿ]/.test(q);
        if (hasFrench) return "fr";
        return "en";
      };

      const executeSearch = async (query) => {
        if (!query.trim()) return;
        setSearchLoading(true);
        try {
          const lang = detectLang(query);
          const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=8&accept-language=${lang}&namedetails=1`;
          const response = await fetch(url, { headers: { "Accept-Language": lang } });
          const data = await response.json();
          if (data && data.length > 0) {
            setSearchRes(data.map(item => {
              // Use localized name if available
              let displayName = item.display_name;
              if (item.namedetails) {
                const localKey = `name:${lang}`;
                if (item.namedetails[localKey]) {
                  // Build localized display: local name + country
                  const parts = item.display_name.split(", ");
                  const country = parts[parts.length - 1];
                  displayName = item.namedetails[localKey] + (country && country !== item.namedetails[localKey] ? ", " + country : "");
                } else if (item.namedetails["name"] && lang !== "en") {
                  displayName = item.namedetails["name"] + ", " + item.display_name.split(", ").slice(-2).join(", ");
                }
              }
              return { id: item.place_id, name: displayName, lat: parseFloat(item.lat), lng: parseFloat(item.lon) };
            }));
            setShowDrop(true);
          } else {
            notify("No locations found. Try being more specific.", "error");
          }
        } catch (err) {
          notify("Search engine connection error.", "error");
        } finally {
          setSearchLoading(false);
        }
      };

      const handleSelectLocation = (loc) => {
        setFocusCoord({ lat: loc.lat, lng: loc.lng });
        setSearchQ(loc.name);
        setSearchRes([]);
        setShowDrop(false);
      };

      /* Auth flow */
      const handleAuthSubmit = async (data) => {
        try {
          let u;
          if (modal === "login") {
            u = await API.loginUser(data.email, data.password);
            setUser(u); setModal(null); notify(`Welcome back, ${u.nickname || u.name}!`);
          } else if (modal === "signup") {
            u = await API.registerUser({ email: data.email, password: data.password, name: data.name, userType: data.userType });
            if (data.userType === "technician") {
              const t = await API.registerTech({
                name: data.name, email: data.email, phone: data.phone, specialty: data.specialty,
                lat: focusCoord ? focusCoord.lat : (20 + Math.random() * 10),
                lng: focusCoord ? focusCoord.lng : (Math.random() * 20),
                userId: u.id,
              });
              u.techId = t.id;
              // update user with techId
              await API.updateUser(u.id, { techId: t.id });
              u = { ...u, techId: t.id };
            }
            // Trigger profile setup
            setPendingUser(u);
            setModal(null);
            setProfileSetupPending(true);
          }
        } catch(err) {
          notify(err.message, "error");
        }
      };

      const handleProfileSetupComplete = (updatedUser) => {
        setUser(updatedUser);
        setProfileSetupPending(false);
        setPendingUser(null);
        notify(`Welcome, ${updatedUser.nickname || updatedUser.name}! 🎉`);
      };

      /* Right-click handler for map */
      const handleMapRightClick = (coord) => {
        if (!user || user.userType !== "technician") return;
        setPendingFlagCoord(coord);
        setFocusCoord(coord);
        const freshUser = DB.get("users").find(u => u.id === user.id);
        const owned = freshUser ? (freshUser.flagsOwned || 0) : 0;
        if (owned <= 0) {
          // No flags owned — go buy
          setModal("payment");
        } else {
          // Has flags — show color picker then confirmation
          setModal("flagColorPick");
        }
      };

      const handlePaymentSuccess = async (qty) => {
        const amount = qty || 1;
        if (user?.techId) {
          await API.subscribe(user.techId);
        }
        // Add flags to user account
        const allU = DB.get("users");
        const ui = allU.findIndex(u => u.id === user.id);
        if (ui >= 0) {
          allU[ui].flagsOwned = (allU[ui].flagsOwned || 0) + amount;
          DB.set("users", allU);
          setUser(prev => ({ ...prev, flagsOwned: (prev.flagsOwned || 0) + amount }));
        }
        await loadTechs();
        notify(`Payment successful! ${amount} flag(s) added. Right-click map to deploy.`);
        setModal(null);
      };

      const handleFlagSave = async (images, color, description) => {
        if (!user?.techId || !pendingFlagCoord) { setModal(null); return; }
        // Build new flag object
        const newFlag = { id:`flag-${Date.now()}`, lat: pendingFlagCoord.lat, lng: pendingFlagCoord.lng, color: color || "#ffffff", images, description: description || "", createdAt: Date.now() };
        const allT = DB.get("technicians");
        const t = allT.find(x => x.id === user.techId);
        if (t) {
          if (!t.flags) t.flags = [];
          t.flags.push(newFlag);
          t.lat = pendingFlagCoord.lat; t.lng = pendingFlagCoord.lng;
          t.flagImages = images; t.flagColor = color;
          t.flagsDeployed = (t.flagsDeployed || 0) + 1;
          DB.set("technicians", allT);
        }
        // Decrease user's flagsOwned
        const freshUser = DB.get("users").find(u => u.id === user.id);
        if (freshUser) {
          freshUser.flagsOwned = Math.max(0, (freshUser.flagsOwned || 0) - 1);
          freshUser.flagsDeployed = (freshUser.flagsDeployed || 0) + 1;
          const allU = DB.get("users");
          const ui = allU.findIndex(u => u.id === user.id);
          if (ui >= 0) { allU[ui] = freshUser; DB.set("users", allU); }
          setUser(prev => ({ ...prev, flagsOwned: freshUser.flagsOwned, flagsDeployed: freshUser.flagsDeployed }));
        }
        await loadTechs();
        notify("Flag deployed on map! 🚩");
        setModal(null);
        setPendingFlagCoord(null);
        setSelectedFlagColor("#ffffff");
      };

      const [selectedFlagColor, setSelectedFlagColor] = useState("#ffffff");

      if (!ready) return <div style={{ padding: 40, textAlign:"center" }}>Booting WRC System...</div>;

      const filteredTechs = selectedCategory === "All" ? technicians : technicians.filter(t => t.specialty === selectedCategory);
      const myTech = user?.techId ? DB.get("technicians").find(t=>t.id===user?.techId) : null;

      /* Profile avatar component */
      const ProfileAvatar = ({ u, size=32 }) => (
        <div style={{ width:size, height:size, background: u.profileImg ? "transparent" : (u.profileColor || C.text), border:`1px solid ${C.border}`, display:"flex", alignItems:"center", justifyContent:"center", overflow:"hidden", flexShrink:0 }}>
          {u.profileImg
            ? <img src={u.profileImg} style={{ width:"100%", height:"100%", objectFit:"cover" }} />
            : <span style={{ color:"white", fontWeight:900, fontSize:size*0.45 }}>{((u.nickname||u.name||"?")[0]).toUpperCase()}</span>
          }
        </div>
      );

      return (
        <div style={{ height:"100vh", display:"flex", flexDirection:"column", background:C.bg, color:C.text }}>

          {/* INTRO OVERLAY (Feature 1) */}
          {showIntro && <IntroOverlay onSkip={()=>setShowIntro(false)} />}

          {/* PROFILE SETUP (Feature 5) */}
          {profileSetupPending && pendingUser && <ProfileSetupModal user={pendingUser} onComplete={handleProfileSetupComplete} />}

          {/* PRIVACY POLICY MODAL (Feature 4) */}
          {showPrivacy && <PrivacyPolicyModal onClose={()=>setShowPrivacy(false)} />}

          {/* SETTINGS MODAL (Feature 6) */}
          {modal === "settings" && user && (
            <SettingsModal user={user} onClose={()=>setModal(null)} onUpdate={(updated)=>{ setUser(updated); notify("Settings saved."); }} />
          )}

          {/* PAYMENT MODAL (Feature 8) */}
          {modal === "payment" && (
            <PaymentModal onSuccess={handlePaymentSuccess} onClose={()=>setModal(null)} flagData={pendingFlagCoord} />
          )}

          {/* FLAG COLOR PICKER */}
          {modal === "flagColorPick" && (
            <FlagColorPickModal onPick={(color)=>{ setSelectedFlagColor(color); setModal("flagConfirm"); }} onClose={()=>setModal(null)} />
          )}

          {/* FLAG CONFIRM */}
          {modal === "flagConfirm" && pendingFlagCoord && (
            <FlagConfirmModal coord={pendingFlagCoord} flagsOwned={user?.flagsOwned || 0} onConfirm={()=>setModal("flagSetup")} onCancel={()=>setModal(null)} />
          )}

          {/* FLAG SETUP MODAL (Feature 8) */}
          {modal === "flagSetup" && (
            <FlagSetupModal tech={myTech||{}} onSave={handleFlagSave} onClose={()=>setModal(null)} flagColor={selectedFlagColor} />
          )}

          {notif && (
            <div style={{ position:"fixed", top:20, right:20, zIndex:9999, background: "#1a1a1a", color: C.white, border: `1px solid ${notif.type==="error" ? C.red : C.green}`, padding:"14px 20px", fontSize:13, fontWeight:600, boxShadow:C.shadow }}>
              {notif.msg}
            </div>
          )}

          {/* HEADER */}
          <header style={{ background:C.white, borderBottom:`1px solid ${C.border}`, height:64, display:"flex", alignItems:"center", padding:"0 24px", gap:24, flexShrink:0, position:"relative", zIndex:1000 }}>
            <div style={{ fontWeight:900, fontSize:20, cursor:"pointer" }} onClick={() => setPage("map")}>WRC</div>

            <div style={{ flex:1, maxWidth:500, position:"relative", display:"flex" }}>
              <input value={searchQ} onChange={(e) => setSearchQ(e.target.value)} onKeyDown={(e) => { if(e.key==='Enter') executeSearch(searchQ); }} placeholder="Search any global town, city, road, or landmark..." style={{...inputStyle, borderRight:"none"}} />
              <button onClick={() => executeSearch(searchQ)} style={{ background:"transparent", border:`1px solid ${C.border}`, borderLeft:"none", padding:"0 16px", cursor:"pointer", color:C.text }}>
                {searchLoading ? "..." : "🔍"}
              </button>
              {searchRes.length > 0 && showDrop && (
                <div style={{ position:"absolute", top:"100%", left:0, right:0, background:C.white, border:`1px solid ${C.text}`, zIndex:3000, maxHeight:300, overflowY:"auto" }}>
                  {searchRes.map(loc => (
                    <div key={loc.id} onClick={() => handleSelectLocation(loc)} style={{ padding:"12px 14px", cursor:"pointer", borderBottom:`1px solid ${C.border}`, fontSize:13, color:C.textMid, textOverflow:"ellipsis", overflow:"hidden", whiteSpace:"nowrap" }}>
                      📍 {loc.name}
                    </div>
                  ))}
                </div>
              )}
            </div>

            <nav style={{ display:"flex", gap:8 }}>
              <button onClick={() => setPage("map")} style={{...ghostBtn, background: page==="map"?C.accentLight:"transparent"}}>Map</button>
              <button onClick={() => setPage("rankings")} style={{...ghostBtn, background: page==="rankings"?C.accentLight:"transparent"}}>Rankings</button>
              <button onClick={() => setPage("dashboard")} style={{...ghostBtn, background: page==="dashboard"?C.accentLight:"transparent"}}>Dashboard</button>
            </nav>

            <div style={{ marginLeft:"auto" }}>
              {user ? (
                <div style={{ display:"flex", alignItems:"center", gap:10, position:"relative" }}>
                  {/* Profile square (Feature 6) */}
                  <ProfileAvatar u={user} size={36} />
                  <span style={{ fontSize:14, fontWeight:700 }}>{user.nickname || user.name}</span>
                  {/* Settings button (Feature 6) */}
                  <button onClick={()=>setShowSettings(v=>!v)} style={{ ...ghostBtn, padding:"6px 10px", fontSize:16 }} title="Settings">⚙️</button>
                  {showSettings && (
                    <div className="settings-dropdown">
                      <div className="settings-item" onClick={()=>{ setModal("settings"); setShowSettings(false); }}>⚙️ Settings</div>
                      <div className="settings-item" onClick={()=>{ setShowSettings(false); setUser(null); notify("Logged out."); setPage("map"); }}>🚪 Log Out</div>
                    </div>
                  )}
                </div>
              ) : (
                <button onClick={() => setModal("login")} style={accentBtn}>Login / Signup</button>
              )}
            </div>
          </header>

          {page === "map" && (
            <div className="no-scrollbar" style={{ background: C.surface, borderBottom:`1px solid ${C.border}`, padding:"10px 24px", display:"flex", gap:12, overflowX:"auto", flexShrink:0 }}>
              <button onClick={()=>setSelectedCategory("All")} style={{...categoryBtn, background: selectedCategory==="All"?C.text:"transparent", color: selectedCategory==="All"?C.white:C.text}}>All Specialized Sectors</button>
              {Object.keys(TECH_CATEGORIES).map(cat => (
                <button key={cat} onClick={()=>setSelectedCategory(cat)} style={{ ...categoryBtn, border:`1px solid ${TECH_CATEGORIES[cat]}`, background: selectedCategory===cat ? TECH_CATEGORIES[cat] : "transparent", color: selectedCategory===cat ? C.white : TECH_CATEGORIES[cat] }}>{cat}</button>
              ))}
            </div>
          )}

          <main style={{ flex:1, display:"flex", overflow:"hidden", position:"relative" }}>
            {page === "map" && (
              <div style={{ flex:1, display:"flex", width:"100%", height:"100%" }}>
                <div style={{ flex:1, height:"100%" }}>
                  <LeafletMap
                    technicians={filteredTechs}
                    onTechClick={handleTechClick}
                    focusCoord={focusCoord}
                    user={user}
                    onRightClick={handleMapRightClick}
                    flagsOwned={user ? (user.flagsOwned || 0) : 0}
                    flagsDeployed={user ? (user.flagsDeployed || 0) : 0}
                    onFlagHudClick={user ? ()=>setModal("payment") : null}
                  />
                </div>
                {selectedTech && !showSNS && (
                  <div style={{ width:380, borderLeft:`1px solid ${C.border}`, background:C.white, height:"100%", display:"flex", flexDirection:"column" }}>
                    <TechPanel
                      tech={selectedTech}
                      reviews={techReviews}
                      user={user}
                      onClose={() => setSelectedTech(null)}
                      onShowSNS={() => setShowSNS(true)}
                      onReviewSubmit={async (tId, r) => {
                        await API.addReview(tId, r);
                        setTechReviews(await API.getReviews(tId));
                        setSelectedTech(await API.getTechById(tId));
                        await loadTechs();
                        notify("Review processed.");
                      }}
                      onLoginRequired={() => setModal("login")}
                    />
                  </div>
                )}
                {selectedTech && showSNS && (
                  <div style={{ width:380, borderLeft:`1px solid ${C.border}`, background:C.white, height:"100%" }}>
                    <TechSNSPanel
                      tech={selectedTech}
                      user={user}
                      onClose={() => { setShowSNS(false); setSelectedTech(null); }}
                      onUpdate={(updated) => setSelectedTech(updated)}
                    />
                  </div>
                )}
              </div>
            )}
            {page === "rankings" && <RankingsPage technicians={technicians} />}
            {page === "dashboard" && (
              <DashboardPage
                user={user}
                technicians={technicians}
                onLogin={() => setModal("login")}
                onPayment={() => setModal("payment")}
              />
            )}
          </main>
          
          {(modal === "login" || modal === "signup") && (
            <AuthModal
              mode={modal}
              onAuth={handleAuthSubmit}
              onClose={()=>setModal(null)}
              onSwitch={setModal}
              notify={notify}
              onShowPrivacy={()=>setShowPrivacy(true)}
            />
          )}
        </div>
      );
    }

    /* ══════════════ SUB COMPONENTS ══════════════ */
    function TechPanel({ tech, reviews, user, onClose, onReviewSubmit, onLoginRequired, onShowSNS }) {
      const [showPhone, setShowPhone] = useState(false);
      const [writing, setWriting] = useState(false);
      const [stars, setStars] = useState(5);
      const [text, setText] = useState("");
      const avg = reviews.length ? (reviews.reduce((s,r)=>s+r.stars,0)/reviews.length).toFixed(1) : 0;
      
      return (
        <div style={{ display:"flex", flexDirection:"column", height:"100%" }}>
          <div style={{ padding:24, borderBottom:`1px solid ${C.border}`, background:C.surface, display:"flex", justifyContent:"space-between" }}>
            <div>
              <div style={{ fontWeight:800, fontSize:20 }}>{tech.name}</div>
              <div style={{ color:C.gold, marginTop:10, fontSize:14, fontWeight:700 }}>★ {avg} ({reviews.length} Reviews)</div>
            </div>
            <button onClick={onClose} style={{ background:"none", border:"none", fontSize:24, cursor:"pointer", padding:0 }}>×</button>
          </div>

          {/* Flag photos */}
          {tech.flagImages && tech.flagImages.length > 0 && (
            <div style={{ display:"flex", gap:4, padding:"10px 16px", background:C.surface, borderBottom:`1px solid ${C.border}`, overflowX:"auto" }}>
              {tech.flagImages.map((img, i) => (
                <img key={i} src={img} style={{ height:60, width:80, objectFit:"cover", border:`1px solid ${C.border}`, flexShrink:0 }} />
              ))}
            </div>
          )}

          <div style={{ flex:1, overflowY:"auto", padding:24 }}>
            {/* SNS profile button */}
            <button onClick={onShowSNS} style={{ ...ghostBtn, width:"100%", marginBottom:12, padding:10, fontSize:13 }}>📰 View SNS Profile & Posts</button>

            {!showPhone
              ? <button onClick={() => { if(!user){onLoginRequired();return;} setShowPhone(true); }} style={{ ...accentBtn, width:"100%", marginBottom:16, padding:14 }}>📞 View Contact</button>
              : <div style={{ border:`2px solid ${C.text}`, padding:14, textAlign:"center", fontWeight:700, fontSize:18, marginBottom:16 }}>{tech.phone}</div>
            }
            {writing ? (
              <div style={{ background:C.surface, padding:16, border:`1px solid ${C.text}`, marginBottom:24 }}>
                <select value={stars} onChange={e=>setStars(Number(e.target.value))} style={{ ...inputStyle, marginBottom:12 }}>
                  <option value="5">★★★★★</option><option value="4">★★★★☆</option><option value="3">★★★☆☆</option>
                </select>
                <textarea value={text} onChange={e=>setText(e.target.value)} placeholder="Write review..." style={{ ...inputStyle, height:80, resize:"none", marginBottom:12 }} />
                <div style={{ display:"flex", gap:8 }}>
                  <button onClick={() => { if(!text.trim())return; onReviewSubmit(tech.id,{user:user.name, stars, text}); setWriting(false); setText(""); }} style={{...accentBtn, flex:1}}>Submit</button>
                  <button onClick={()=>setWriting(false)} style={{...ghostBtn, flex:1}}>Cancel</button>
                </div>
              </div>
            ) : (
              <button onClick={()=>{ if(!user){onLoginRequired();return;} setWriting(true); }} style={{ ...ghostBtn, width:"100%", marginBottom:24, padding:12 }}>✎ Write Review</button>
            )}
            {reviews.map(r=>(
              <div key={r.id} style={{ borderBottom:`1px solid ${C.border}`, paddingBottom:12, marginBottom:12 }}>
                <div style={{ display:"flex", justifyContent:"space-between", marginBottom:4 }}><strong>{r.user}</strong><span style={{color:C.gold}}>★{r.stars}</span></div>
                <div style={{ color:C.textMid, fontSize:14 }}>{r.text}</div>
              </div>
            ))}
          </div>
        </div>
      );
    }

    function RankingsPage({ technicians }) {
