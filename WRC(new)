        const t = { ...data, id:`tech-${Date.now()}`, stars:0, reviewCount:0, score:0, active:false, createdAt:Date.now(), bio:"", posts:[] };
        all.push(t); DB.set("technicians", all); return t;
      },
      async updateTech(id, updates) {
        const all = DB.get("technicians");
        const idx = all.findIndex(t=>t.id===id);
        if (idx>=0) { all[idx]={...all[idx],...updates}; DB.set("technicians", all); return all[idx]; }
      },
      async subscribe(techId) {
        const all = DB.get("technicians");
        const t = all.find(x=>x.id===techId);
        if (t) { t.active=true; DB.set("technicians", all); }
      },
      async addReview(techId, review) {
        const revs = DB.get("reviews");
        revs.push({ id:`rv-${Date.now()}`, techId, ...review, createdAt:Date.now() });
        DB.set("reviews", revs);
        const allTechs = DB.get("technicians");
        const t = allTechs.find(x=>x.id===techId);
        if (t) {
          const myRevs = revs.filter(r=>r.techId===techId);
          t.stars = parseFloat((myRevs.reduce((s,r)=>s+r.stars,0)/myRevs.length).toFixed(1));
          t.reviewCount = myRevs.length;
          t.score = Math.floor(t.stars*1000 + t.reviewCount*500);
          DB.set("technicians", allTechs);
        }
      },
      async addPost(techId, post) {
        const all = DB.get("technicians");
        const t = all.find(x=>x.id===techId);
        if (t) {
          if (!t.posts) t.posts = [];
          t.posts.push({ id:`post-${Date.now()}`, ...post, createdAt:Date.now() });
          DB.set("technicians", all);
          return t;
        }
      },
      async getAdSlots() { return DB.get("adSlots") || []; },
      async bookAdSlot(slot) {
        const slots = DB.get("adSlots") || [];
        slots.push({ ...slot, id:`ad-${Date.now()}`, createdAt: Date.now() });
        DB.set("adSlots", slots);
        return slots;
      }
    };

